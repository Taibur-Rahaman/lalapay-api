{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/health-ready.ts": {
      "maxDuration": 10,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/health/ready", "destination": "/api/health-ready" },
    { "source": "/api/v1/:path*", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/reconcile", "schedule": "0 3 * * *" }
  ]
}
